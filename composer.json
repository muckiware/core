{
    "name": "muckiware/core",
    "type": "library",
    "description": "Muckidrive core component",
    "license": "MIT",
    "version": "0.0.1.0",
    "autoload": {
        "psr-4": {
            "Muckiware\\Core\\": ""
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
