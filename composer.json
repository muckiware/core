{
    "name": "muckiware/core",
    "type": "library",
    "description": "Muckidrive core component",
    "license": "MIT",
    "version": "0.1.0.0",
    "autoload": {
        "psr-4": {
            "Muckiware\\Core\\": ""
        },
        "exclude-from-classmap": [
            "Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Muckiware\\Core\\Tests\\": "Tests/"
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "shopware/core": "v6.7.16"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
